# Flask 应用配置示例文件
# 复制此文件为 .env 并修改为实际配置
# 注意：.env 文件包含敏感信息，不要提交到 Git

# Flask 密钥（用于 session 加密）
SECRET_KEY=campus-quest-pro-secret-key

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_quest_pro_db
DB_USER=root
DB_PASSWORD=your_password_here  # ← 修改为你的实际密码

# SQLAlchemy 配置
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JSON 响应配置
JSON_AS_ASCII=False

# 文件上传大小限制（2MB）
MAX_CONTENT_LENGTH=2097152
#一个提交测试